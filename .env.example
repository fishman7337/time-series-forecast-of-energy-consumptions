# Local environment template for Energy Consumption Forecasting.
# Copy to .env for local use. Do not commit real secrets or private paths.

# Dataset paths
ENERGY_DATA_PATH=data/raw/CA2-Energy-Consumption-Data.csv
PROCESSED_DATA_DIR=data/processed

# Artifact paths
MODEL_DIR=models
REPORTS_DIR=reports

# Forecasting configuration
TEST_HORIZON_MONTHS=60
FORECAST_STEPS=60

# Optional experiment tracking endpoint, if MLflow is introduced later.
MLFLOW_TRACKING_URI=

# Keep notebook/script output quieter during local experimentation.
PYTHONWARNINGS=default
